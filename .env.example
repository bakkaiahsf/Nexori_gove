# ============================================================
# NexoriOS — Environment Variables Template
# Copy this to .env.local and fill in real values.
# NEVER commit .env.local to git.
# ============================================================

# ── Database (Supabase / PostgreSQL) ────────────────────────
# Pooled connection — used by Prisma at runtime (Next.js API routes)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection — used by Prisma for migrations only
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# ── Supabase Client (safe to expose in browser) ─────────────
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."

# ── Supabase Admin (server-side only — NEVER in browser) ────
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ── Anthropic (Claude APIs — primary AI layer) ──────────────
ANTHROPIC_API_KEY="sk-ant-api03-..."
# Model defaults (override per use case)
ANTHROPIC_MODEL_PRIMARY="claude-sonnet-4-6"
ANTHROPIC_MODEL_FAST="claude-haiku-4-5-20251001"
ANTHROPIC_MODEL_STRATEGIC="claude-opus-4-6"

# ── OpenAI (embeddings only — text-embedding-3-small) ───────
OPENAI_API_KEY="sk-proj-..."
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_EMBEDDING_DIMENSIONS="1536"

# ── NextAuth.js ──────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32-output"
# Local dev: http://localhost:3000 | Production: https://nexori-os.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# ── GitHub (MCP connector + optional OAuth) ─────────────────
GITHUB_PAT="ghp_..."
# OAuth (optional — for GitHub sign-in via NextAuth)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ── Figma (MCP design connector — dev only) ─────────────────
FIGMA_API_KEY="figd_..."

# ── NexoriOS Application Config ─────────────────────────────
NEXORI_ENV="development"
NEXORI_PRODUCT="NexoriOS"
NEXORI_VERSION="0.1.0-mvp"
NEXT_PUBLIC_APP_NAME="NexoriOS"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI Governance Controls
AI_GOVERNANCE_STRICT="true"
REGULATORY_MODE="DORA_EU_AI_ACT"
AUDIT_LOGGING_ENABLED="true"
EMERGENCY_LOCK_ENABLED="true"

# RAG Configuration
RAG_CHUNK_SIZE="512"
RAG_CHUNK_OVERLAP="64"
RAG_TOP_K_SEMANTIC="5"
RAG_TOP_K_KEYWORD="3"
RAG_MIN_SIMILARITY_THRESHOLD="0.72"
RAG_MAX_CONTEXT_TOKENS="2048"

# Rate Limiting (AI endpoints — prevent token drain)
AI_RATE_LIMIT_PER_USER_PER_MINUTE="20"
AI_RATE_LIMIT_PER_TENANT_PER_MINUTE="100"
AI_MAX_TOKENS_PER_REQUEST="4096"

# Tenant / Multi-tenancy (Phase 2 — set default for Phase 1)
DEFAULT_TENANT_ID="nexori-dev-tenant"

# ── Vercel (set automatically by Vercel — do not set manually) ──
# VERCEL_URL — automatically set by Vercel on each deployment
# VERCEL_ENV — "production" | "preview" | "development"
