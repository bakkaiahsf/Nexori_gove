# ============================================================
# NexoriOS — Environment Variables Template
# Copy to .env.local and fill in real values.
# NEVER commit .env.local to git.
# ============================================================

# ── Database (Supabase PostgreSQL) ──────────────────────────
# Prisma reads THESE exact names — do not rename them.
# Pooled connection (port 6543, pgbouncer=true) — used at runtime
DATABASE_URL="postgres://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"
# Direct connection (port 5432) — used by Prisma Migrate only
DIRECT_URL="postgres://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# ── Supabase Client ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."
SUPABASE_JWT_SECRET="..."

# ── AI — Dynamic Router ──────────────────────────────────────
AI_DEFAULT_PROVIDER="openai"
AI_DEFAULT_MODEL="gpt-4o-mini"
OPENAI_API_KEY="sk-proj-..."
ANTHROPIC_API_KEY="sk-ant-..."

# ── GitHub (governance integration) ─────────────────────────
GITHUB_TOKEN="github_pat_..."
GITHUB_ORG="your-org"

# ── Jira (governance integration) ────────────────────────────
JIRA_BASE_URL="https://your-workspace.atlassian.net"
JIRA_EMAIL="your@email.com"
JIRA_API_TOKEN="ATATT3x..."
JIRA_PROJECT_KEY="SCRUM"

# ── NextAuth.js ──────────────────────────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-generated-secret"
# Production: set to your Vercel deployment URL
NEXTAUTH_URL="http://localhost:3000"

# ── NexoriOS Config ──────────────────────────────────────────
NEXORI_ENV="development"
NEXORI_PRODUCT="NexoriOS"
NEXORI_VERSION="0.1.0-mvp"
NEXT_PUBLIC_APP_NAME="NexoriOS"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Governance Controls ──────────────────────────────────────
AI_GOVERNANCE_STRICT="true"
REGULATORY_MODE="DORA_EU_AI_ACT"
AUDIT_LOGGING_ENABLED="true"
EMERGENCY_LOCK_ENABLED="true"

# ── RAG Configuration ────────────────────────────────────────
RAG_CHUNK_SIZE="512"
RAG_CHUNK_OVERLAP="64"
RAG_TOP_K_SEMANTIC="5"
RAG_TOP_K_KEYWORD="3"
RAG_MIN_SIMILARITY_THRESHOLD="0.72"
RAG_MAX_CONTEXT_TOKENS="2048"

# ── Rate Limiting ────────────────────────────────────────────
AI_RATE_LIMIT_PER_USER_PER_MINUTE="20"
AI_RATE_LIMIT_PER_TENANT_PER_MINUTE="100"
AI_MAX_TOKENS_PER_REQUEST="4096"

# ── Multi-tenancy ────────────────────────────────────────────
DEFAULT_TENANT_ID="nexori-dev-tenant"

# Vercel sets these automatically — do not set manually:
# VERCEL_URL, VERCEL_ENV
