generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum AIControlMode {
  HUMAN_ONLY
  AI_ASSIST
  AI_REVIEW
  AI_CONTROLLED_ACTION
  AI_GOVERNED       // AI orchestrates workflows under policy constraints
  AI_RESTRICTED     // AI disabled for this regulated delivery (per-case override)
  EMERGENCY_LOCK
}

enum GovernanceEventType {
  PROJECT_CREATED
  GATE_CREATED
  GATE_OPENED
  GATE_APPROVED
  GATE_REJECTED
  EVIDENCE_SUBMITTED
  APPROVAL_REQUESTED
  APPROVAL_GRANTED
  APPROVAL_REJECTED
  AI_MODE_CHANGED
  AI_EMERGENCY_LOCK
  AI_INVOCATION
  RISK_RAISED
  RISK_MITIGATED
  REGULATORY_MAPPING_ADDED
  THIRD_PARTY_REGISTERED
  // Adaptive governance intelligence events
  CONTEXT_ENRICHED
  RISK_SCORED
  PIPELINE_ADAPTED
  GATE_SKIPPED
  APPROVAL_INHERITED
  WAIVER_REQUESTED
  WAIVER_APPROVED
  JIRA_WRITEBACK_COMPLETE
  // Case lifecycle
  CASE_CREATED
  CASE_RESOLVED
  CASE_REOPENED
  CASE_COMMENT_ADDED
  CASE_ASSIGNED
  EVIDENCE_REQUESTED
  // Trigger engine events
  TRIGGER_MATCHED
  TRIGGER_SKIPPED
  CONNECTOR_EVENT_RECEIVED
  // Program & board events
  PROGRAM_CREATED
  PROJECT_ASSIGNED_TO_PROGRAM
  BOARD_ADDED
  // Guardrails
  GUARDRAIL_PUSHED
  GUARDRAIL_MERGED
  GUARDRAIL_REJECTED
  // Exception dual-tracking
  EXCEPTION_STORY_CREATED
  // Gate bundles
  GATE_BUNDLE_APPLIED
}

enum TriggerAction {
  FULL_PIPELINE   // full context enrichment → scoring → adaptive gate pipeline
  CLASSIFY_ONLY   // score and classify only, no gate pipeline created
  SKIP            // explicitly ignore (logged)
}

enum GateStatus {
  PENDING
  OPEN
  APPROVED
  REJECTED
  BYPASSED_WITH_EXCEPTION
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum EvidenceType {
  DOCUMENT
  TEST_RESULT
  AUDIT_LOG
  SCREENSHOT
  SIGNED_ATTESTATION
  POLICY_REFERENCE
  EXTERNAL_LINK
}

enum RegulatoryFramework {
  DORA
  EU_AI_ACT
  SOC2
  ISO_27001
  PCI_DSS
  GDPR
}

enum RiskStatus {
  OPEN
  MITIGATING
  RESOLVED
  ACCEPTED
}

enum RiskSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ─────────────────────────────────────────────
// IDENTITY
// ─────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      String   @default("viewer") // admin|governance-owner|approver|viewer
  tenantId  String?
  createdAt DateTime @default(now())

  approvalRequests ApprovalRequest[] @relation("RequestedBy")
  approvals        ApprovalRequest[] @relation("ResolvedBy")
  governanceEvents GovernanceEvent[]

  @@map("users")
}

// ─────────────────────────────────────────────
// PROJECT
// ─────────────────────────────────────────────

model Program {
  id          String    @id @default(cuid())
  name        String
  description String?
  ownerEmail  String?
  status      String    @default("ACTIVE") // ACTIVE|ARCHIVED
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  projects Project[]

  @@map("programs")
}

model Project {
  id                 String   @id @default(cuid())
  key                String   @unique
  name               String
  description        String?
  domain             String?
  classification     String?  // public|internal|confidential|restricted
  ownerEmail         String
  tenantId           String?
  status             String   @default("active") // active|archived|paused
  programId          String?
  governanceProfile  String   @default("agile")  // agile|regulated|ai_sensitive|critical|third_party|custom
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  program            Program?               @relation(fields: [programId], references: [id])
  aiControlSetting   AIControlSetting?
  governanceCases    GovernanceCase[]
  governanceEvents   GovernanceEvent[]
  evidenceItems      EvidenceItem[]
  risks              RiskItem[]
  thirdPartyDeps     ThirdPartyDependency[]
  regulatoryMappings RegulatoryMapping[]
  governanceWaivers  GovernanceWaiver[]
  triggerRules       GovernanceTriggerRule[]
  boards             ProjectBoard[]
  guardrailPushes    GuardrailPush[]
  ragSources         ProjectRagSource[]

  @@map("projects")
}

model ProjectBoard {
  id          String   @id @default(cuid())
  projectId   String
  connectorId String
  boardId     String   // external board ID in the tool
  boardName   String
  boardType   String   @default("scrum") // scrum|kanban
  enabled     Boolean  @default(true)
  labelTag    String?  // e.g. "payments" — auto-tags governance items from this board
  riskOverride String? // "high"|"medium"|null — forces risk level for all items from this board
  createdAt   DateTime @default(now())

  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  connector SourceConnector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@unique([projectId, connectorId, boardId])
  @@map("project_boards")
}

model ProjectRagSource {
  id            String    @id @default(cuid())
  projectId     String
  type          String    // "confluence"|"github-path"|"gitlab-path"|"url"|"policy-corpus"
  name          String
  config        Json      // { spaceKey?, repoPath?, url?, connectorId?, branchName? }
  enabled       Boolean   @default(true)
  lastIndexedAt DateTime?
  createdAt     DateTime  @default(now())

  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_rag_sources")
}

model GateBundle {
  id         String   @id @default(cuid())
  name       String
  stage      String   // planning|development|pre-prod|deployment
  gateSlugs  String[]
  frameworks String[]
  mandatory  Boolean  @default(false)
  isBuiltIn  Boolean  @default(false)
  projectId  String?  // null = global default
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("gate_bundles")
}

model GuardrailPush {
  id          String    @id @default(cuid())
  projectId   String
  connectorId String
  framework   String    // GDPR|DORA|SOC2 etc.
  repoPath    String    // .github/governance/gdpr-rules.yaml
  prUrl       String?
  prNumber    Int?
  status      String    @default("PENDING") // PENDING|MERGED|REJECTED|FAILED
  rulesHash   String    // SHA256 of generated YAML
  generatedAt DateTime  @default(now())
  mergedAt    DateTime?

  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  connector SourceConnector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([connectorId])
  @@map("guardrail_pushes")
}

// ─────────────────────────────────────────────
// AI CONTROL
// ─────────────────────────────────────────────

model AIControlSetting {
  id          String         @id @default(cuid())
  projectId   String         @unique
  mode        AIControlMode  @default(AI_ASSIST)
  setBy       String
  setAt       DateTime       @default(now())
  reason      String?
  emergencyAt DateTime?
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("ai_control_settings")
}

model AIUsageEvent {
  id              String   @id @default(cuid())
  projectId       String?
  sessionId       String?
  model           String
  mode            AIControlMode
  action          String
  query           String?
  chunkIds        String[]
  tokensIn        Int      @default(0)
  tokensOut       Int      @default(0)
  outcome         String   // success|blocked|error
  blockedReason   String?
  governanceRef   String?
  timestamp       DateTime @default(now())

  @@map("ai_usage_events")
}

// ─────────────────────────────────────────────
// GOVERNANCE FLIGHT RECORDER
// Append-only. No updates, no deletes.
// ─────────────────────────────────────────────

model GovernanceEvent {
  id          String              @id @default(cuid())
  projectId   String?
  type        GovernanceEventType
  actorEmail  String?
  actorId     String?
  resourceType String?
  resourceId   String?
  payload      Json?
  ipAddress    String?
  tenantId     String?
  timestamp    DateTime            @default(now())

  project Project? @relation(fields: [projectId], references: [id])
  actor   User?    @relation(fields: [actorId], references: [id])

  @@index([projectId, timestamp])
  @@index([type])
  @@map("governance_events")
}

// ─────────────────────────────────────────────
// GOVERNANCE CASES & GATES
// ─────────────────────────────────────────────

model GovernanceCase {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  description String?
  phase       String   // change-delivery|ai-deployment|incident|third-party-onboarding
  status      String   @default("active") // active|closed|archived
  ownedBy     String
  // Source tool linkage
  sourceEpicKey     String?  // e.g. "BANK-120" — originating Jira epic
  sourceGovEpicKey  String?  // e.g. "BANK-145" — [GOV] epic written back to Jira
  sourceConnectorId String?  // FK to SourceConnector (soft ref — no Prisma relation to avoid circular)
  resolvedAt        DateTime?
  resolvedBy        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  governanceGates  GovernanceGate[]
  evidenceItems    EvidenceItem[]
  context          GovernanceContext?
  riskScore        GovernanceRiskScore?
  adaptivePipeline AdaptivePipeline?
  comments         CaseComment[]

  @@map("governance_cases")
}

model CaseComment {
  id          String         @id @default(cuid())
  caseId      String
  authorEmail String
  body        String
  createdAt   DateTime       @default(now())
  case        GovernanceCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@map("case_comments")
}

model GovernanceGate {
  id          String      @id @default(cuid())
  caseId      String
  name        String
  description String?
  order       Int
  required    Boolean     @default(true)
  status      GateStatus  @default(PENDING)
  approvedAt  DateTime?
  approvedBy  String?
  rejectedAt  DateTime?
  rejectedBy  String?
  exceptionRef String?
  // Adaptive pipeline fields
  definitionSlug String?  // links to GateDefinition.slug
  sourceStoryKey String?  // Jira story key written back for this gate
  inheritedFrom  String?  // GovernanceCase.id if this gate was auto-approved from a prior case
  skipped        Boolean  @default(false)
  skipReason     String?
  createdAt   DateTime    @default(now())

  case             GovernanceCase    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  approvalRequests ApprovalRequest[]

  @@map("governance_gates")
}

// ─────────────────────────────────────────────
// APPROVALS
// ─────────────────────────────────────────────

model ApprovalRequest {
  id           String         @id @default(cuid())
  gateId       String
  requestedById String?
  requestedAt  DateTime       @default(now())
  status       ApprovalStatus @default(PENDING)
  resolvedById String?
  resolvedAt   DateTime?
  notes        String?
  expiresAt    DateTime?

  gate        GovernanceGate @relation(fields: [gateId], references: [id], onDelete: Cascade)
  requestedBy User?          @relation("RequestedBy", fields: [requestedById], references: [id])
  resolvedBy  User?          @relation("ResolvedBy", fields: [resolvedById], references: [id])

  @@map("approval_requests")
}

// ─────────────────────────────────────────────
// EVIDENCE ENGINE
// Immutable, append-only. No soft deletes.
// ─────────────────────────────────────────────

model EvidenceItem {
  id          String       @id @default(cuid())
  projectId   String
  caseId      String?
  type        EvidenceType
  title       String
  description String?
  content     String?
  fileUrl     String?
  hash        String?
  submittedBy String
  submittedAt DateTime     @default(now())
  externalRef String?

  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  case               GovernanceCase?     @relation(fields: [caseId], references: [id])
  regulatoryMappings RegulatoryMapping[]

  @@index([projectId])
  @@map("evidence_items")
}

// ─────────────────────────────────────────────
// REGULATORY MAPPING
// ─────────────────────────────────────────────

model RegulatoryMapping {
  id           String              @id @default(cuid())
  projectId    String
  evidenceId   String
  framework    RegulatoryFramework
  controlId    String
  controlName  String?
  description  String?
  mappedBy     String
  mappedAt     DateTime            @default(now())
  verifiedAt   DateTime?
  verifiedBy   String?

  project  Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  evidence EvidenceItem @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@unique([evidenceId, framework, controlId])
  @@map("regulatory_mappings")
}

// ─────────────────────────────────────────────
// RISK REGISTER
// ─────────────────────────────────────────────

model RiskItem {
  id          String       @id @default(cuid())
  projectId   String
  title       String
  description String?
  category    String       // technical|schedule|regulatory|operational|ai|third-party
  severity    RiskSeverity
  status      RiskStatus   @default(OPEN)
  mitigation  String?
  owner       String?
  source      String       @default("manual") // manual|ai-extracted|governance-event
  sourceRef   String?
  raisedAt    DateTime     @default(now())
  resolvedAt  DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("risk_items")
}

// ─────────────────────────────────────────────
// DORA THIRD-PARTY REGISTER
// Required by DORA Article 28
// ─────────────────────────────────────────────

model ThirdPartyDependency {
  id               String   @id @default(cuid())
  projectId        String
  vendorName       String
  serviceType      String   // cloud|saas|ai-model|data|security|identity
  criticality      String   // critical|important|standard
  contractRef      String?
  dataProcessed    String?
  regionOfHosting  String?
  certifications   String[]
  lastReviewedAt   DateTime?
  nextReviewDue    DateTime?
  registeredBy     String
  registeredAt     DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("third_party_dependencies")
}

// ═════════════════════════════════════════════
// ADAPTIVE GOVERNANCE INTELLIGENCE LAYER
// ═════════════════════════════════════════════

// ─────────────────────────────────────────────
// SOURCE CONNECTOR — tool-agnostic intake
// ─────────────────────────────────────────────

model SourceConnector {
  id            String   @id @default(cuid())
  tenantId      String?
  type          String   // "jira"|"linear"|"github"|"azure-devops"|"servicenow"
  name          String
  baseUrl       String
  credentials   Json     // encrypted: { email, apiToken } or { token }
  webhookSecret String?  // HMAC-SHA256 secret for webhook verification
  projectKeys   String[] // e.g. ["BANK", "CARDS"] — Jira project keys to watch
  fieldMapping  Json?    // custom field name → governance signal mapping
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())

  epics           EpicSnapshot[]
  boards          ProjectBoard[]
  guardrailPushes GuardrailPush[]

  @@map("source_connectors")
}

// ─────────────────────────────────────────────
// EPIC SNAPSHOT — immutable intake record
// Never mutated after creation
// ─────────────────────────────────────────────

model EpicSnapshot {
  id          String   @id @default(cuid())
  connectorId String
  sourceKey   String   // "BANK-120"
  sourceType  String   // "epic"|"portfolio-epic"|"initiative"
  title       String
  description String?
  labels      String[]
  components  String[]
  customFields Json?   // raw custom field values at intake time
  timeline    Json?    // { startDate, dueDate, milestones[] }
  snapshotAt  DateTime @default(now())

  connector SourceConnector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@index([connectorId])
  @@index([sourceKey])
  @@map("epic_snapshots")
}

// ─────────────────────────────────────────────
// GOVERNANCE CONTEXT — multi-source enrichment
// 1:1 with GovernanceCase
// ─────────────────────────────────────────────

model GovernanceContext {
  id                   String   @id @default(cuid())
  caseId               String   @unique
  epicTitle            String
  epicDescription      String?
  sourceKey            String?
  sourceType           String?
  labels               String[]
  components           String[]
  environment          String?  // "production"|"staging"|"development"|"sandbox"
  dataClassification   String?  // "personal"|"financial"|"public"|"confidential"|"restricted"
  aiSystemInvolved     Boolean  @default(false)
  thirdPartyChanges    Boolean  @default(false)
  infrastructureChange Boolean  @default(false)
  linkedSystemIds      String[]
  priorIncidents       Int      @default(0)
  lastDeployDaysAgo    Int?
  confluenceRefs       String[]
  contextSummary       String?  // AI-generated narrative summary
  enrichedAt           DateTime @default(now())

  case GovernanceCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@map("governance_contexts")
}

// ─────────────────────────────────────────────
// GOVERNANCE RISK SCORE — 11-dimension scoring
// 1:1 with GovernanceCase
// ─────────────────────────────────────────────

model GovernanceRiskScore {
  id               String   @id @default(cuid())
  caseId           String   @unique

  // 11 dimensions — 0.0 to 1.0
  productionImpact Float    @default(0)
  customerImpact   Float    @default(0)
  aiInvolvement    Float    @default(0)
  dataExposure     Float    @default(0)
  infraImpact      Float    @default(0)
  regulatoryExp    Float    @default(0)
  incidentHistory  Float    @default(0)
  thirdPartyRisk   Float    @default(0)
  deploymentCrit   Float    @default(0)
  securitySens     Float    @default(0)
  blastRadius      Float    @default(0)

  // Computed
  compositeScore      Float   // 0–100 weighted composite
  intensity           String  // "minimal"|"standard"|"regulated"|"enhanced"
  scoringConfidence   Float   // 0–1
  aiModeRecommended   String  // suggested AIControlMode
  reasoning           String? // AI narrative explaining score
  retrievedPolicyIds  String[] // PolicyChunk IDs cited — RAG audit trail

  scoredAt DateTime @default(now())

  case GovernanceCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@map("governance_risk_scores")
}

// ─────────────────────────────────────────────
// GATE DEFINITION — atomic reusable gate library
// Built-in (isBuiltIn) + admin-created
// ─────────────────────────────────────────────

model GateDefinition {
  id                String   @id @default(cuid())
  tenantId          String?
  slug              String   @unique  // "cab-approval"|"ai-risk-assessment"|"dpo-review"
  name              String
  description       String?
  category          String   // "security"|"architecture"|"ai-governance"|"regulatory"|"operational"|"change-management"
  defaultSlaHours   Int      @default(24)
  intensityTriggers String[] // ["standard","regulated","enhanced"] — intensities that include this gate
  skipConditions    Json?    // declarative rules: [{ field, op, value }]
  requiredEvidence  String[] // EvidenceType values required before approval
  approverRoles     String[] // "security"|"dpo"|"cab"|"ai-governance"|"architecture"|"regulatory"
  isBuiltIn         Boolean  @default(false)
  enabled           Boolean  @default(true)
  createdAt         DateTime @default(now())

  @@map("gate_definitions")
}

// ─────────────────────────────────────────────
// GOVERNANCE TEMPLATE — admin-configurable blueprint
// Defines which gate categories apply at each stage.
// AI composer selects specific gates from the gate library.
// ─────────────────────────────────────────────

model GovernanceTemplate {
  id                  String   @id @default(cuid())
  name                String
  description         String?
  icon                String?
  effort              String   @default("MEDIUM") // LOW | MEDIUM | HIGH | CUSTOM
  stages              Json     @default("[]")      // [{stage, gateCategories, gateHints}]
  suggestedFrameworks String[] @default([])
  suggestedDomains    String[] @default([])
  isBuiltIn           Boolean  @default(false)
  enabled             Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("governance_templates")
}

// ─────────────────────────────────────────────
// ADAPTIVE PIPELINE — composition audit record
// 1:1 with GovernanceCase
// ─────────────────────────────────────────────

model AdaptivePipeline {
  id                   String   @id @default(cuid())
  caseId               String   @unique
  riskScoreId          String
  composerVersion      String   @default("1.0")
  gatesIncluded        Json     // [{ slug, order, reason }]
  gatesSkipped         Json     // [{ slug, skipReason, conditionMet }]
  inheritedApprovals   Json?    // [{ gateSlug, inheritedFromCaseId, rationale }]
  totalGateCount       Int
  reducedFromBaseline  Int      @default(0) // gates removed vs naive baseline — the ROI metric
  composedAt           DateTime @default(now())

  case GovernanceCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@map("adaptive_pipelines")
}

// ─────────────────────────────────────────────
// GOVERNANCE WAIVER — formal exception record
// ─────────────────────────────────────────────

model GovernanceWaiver {
  id                   String    @id @default(cuid())
  projectId            String
  caseId               String?
  gateId               String?
  requestedBy          String
  waiverType           String    // "emergency"|"time-limited"|"risk-accepted"|"expedited-path"
  reason               String
  residualRisk         String?   // AI-generated residual risk statement
  compensatingControls Json?     // [{ control, owner, dueDate }]
  status               String    @default("pending") // pending|approved|rejected|expired
  approvedBy           String?
  approvedAt           DateTime?
  expiresAt            DateTime?
  auditBundle          Json?     // full context snapshot at waiver time
  requestedAt          DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([caseId])
  @@map("governance_waivers")
}

// ─────────────────────────────────────────────
// EXPERT PROFILE — reviewer routing intelligence
// ─────────────────────────────────────────────

model ExpertProfile {
  id                 String    @id @default(cuid())
  tenantId           String?
  email              String    @unique
  name               String?
  domains            String[]  // "ai-governance"|"security"|"architecture"|"dpo"|"cab"|"regulatory"
  jurisdictions      String[]  // ["EU","UK","US","GLOBAL"]
  activeApprovals    Int       @default(0)
  avgResolutionHours Float?
  lastActiveAt       DateTime?
  createdAt          DateTime  @default(now())

  @@map("expert_profiles")
}

// ─────────────────────────────────────────────
// POLICY DOCUMENT — internal policy RAG corpus
// ─────────────────────────────────────────────

model PolicyDocument {
  id          String    @id @default(cuid())
  tenantId    String?
  title       String
  type        String    // "internal-policy"|"sop"|"risk-appetite"|"regulatory-guidance"
  content     String
  version     String?
  effectiveAt DateTime?
  uploadedBy  String
  uploadedAt  DateTime  @default(now())
  indexedAt   DateTime?

  chunks PolicyChunk[]

  @@map("policy_documents")
}

// ─────────────────────────────────────────────
// POLICY CHUNK — chunked text with pgvector
// Requires: CREATE EXTENSION IF NOT EXISTS vector
// ─────────────────────────────────────────────

model PolicyChunk {
  id         String   @id @default(cuid())
  documentId String
  chunkIndex Int
  text       String
  embedding  Unsupported("vector(1536)")?
  tokenCount Int      @default(0)
  createdAt  DateTime @default(now())

  document PolicyDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("policy_chunks")
}

// ─────────────────────────────────────────────
// GOVERNANCE TRIGGER ENGINE
// Admin-configurable rules: which tool events trigger governance
// ─────────────────────────────────────────────

model GovernanceTriggerRule {
  id          String        @id @default(cuid())
  projectId   String
  name        String
  description String?
  source      String        // "jira"|"github"|"gitlab"
  eventType   String        // "epic.created"|"pr.opened"|"mr.merged"|"issue.updated"|...
  conditions  Json          // [{ field: string, op: "eq"|"contains"|"gt"|"lt"|"matches", value: string|number }]
  action            TriggerAction
  priority          Int           @default(100) // higher priority evaluated first
  enabled           Boolean       @default(true)
  createdBy         String
  sourceProjectRef  String?   // "owner/repo" | "namespace/project" | "JIRA-KEY"
  sourceBoardRef    String?   // Jira board ID / GitHub project number
  scheduleCron      String?   // cron expression for monitoring, e.g. "0 */6 * * *"
  lastRunAt         DateTime?
  lastRunResult     String?   // "ok"|"error:api_key"|"error:permissions"|"error:not_found"|"error:rate_limited"
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  evaluations TriggerEvaluation[]

  @@index([projectId, source, enabled])
  @@map("governance_trigger_rules")
}

// ─────────────────────────────────────────────
// TRIGGER EVALUATION — audit log of every incoming event
// Records every webhook event and whether it matched a rule
// ─────────────────────────────────────────────

model TriggerEvaluation {
  id           String        @id @default(cuid())
  ruleId       String?       // null = no rule matched
  connectorId  String?
  projectId    String?
  sourceType   String        // "jira"|"github"|"gitlab"
  eventType    String        // e.g. "epic.created", "pr.opened"
  eventKey     String        // e.g. "BANK-120", "owner/repo#42"
  matched      Boolean
  action       TriggerAction?
  caseId       String?       // linked GovernanceCase if governance was triggered
  payload      Json          // raw event payload snapshot
  evaluatedAt  DateTime      @default(now())

  rule GovernanceTriggerRule? @relation(fields: [ruleId], references: [id])

  @@index([projectId, evaluatedAt])
  @@index([sourceType, eventKey])
  @@map("trigger_evaluations")
}

// ─────────────────────────────────────────────
// PULL REQUEST — PR/MR governance link
// Links GitHub PR or GitLab MR to a GovernanceCase
// ─────────────────────────────────────────────

model PullRequest {
  id               String    @id @default(cuid())
  connectorId      String
  prNumber         Int
  repo             String    // "owner/repo"
  title            String
  author           String
  targetBranch     String
  sourceBranch     String
  filesChanged     Int       @default(0)
  linesAdded       Int       @default(0)
  linesRemoved     Int       @default(0)
  labels           String[]
  state            String    @default("open") // open|merged|closed
  caseId           String?   // linked GovernanceCase (null if governance not triggered)
  governanceStatus String    @default("pending") // pending|active|cleared|exempt
  externalUrl      String?
  createdAt        DateTime  @default(now())
  mergedAt         DateTime?
  closedAt         DateTime?

  @@index([connectorId, prNumber])
  @@index([caseId])
  @@map("pull_requests")
}
